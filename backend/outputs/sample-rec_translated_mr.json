        {
            "id": 7,
            "type": "paragraph",
            "list_type": null,
            "level": null,
            "order": 7,
            "text": "DOCX फाइलला PDF मध्ये रूपांतरित करताना, प्रतिमांना त्यांचे मूळ रिझोल्यूशन आणि आस्पेक्ट रेशियो कायम ठेवावे. साध्या मजकूरात रूपांतरित करताना, प्रतिमा सामान्यतः वगळल्या जातात कारण स्वरूप दृश्य सामग्रीचे प्रतिनिधित्व करू शकत नाही. वापरकर्त्याची अपेक्षा निश्चित करण्यासाठी हे फरक समजून घेणे महत्त्वाचे आहे.",
            "runs": [
                {
                    "text": "DOCX फाइलला PDF मध्ये रूपांतरित करताना, प्रतिमांना त्यांचे मूळ रिझोल्यूशन आणि आस्पेक्ट रेशियो कायम ठेवावे. साध्या मजकूरात रूपांतरित करताना, प्रतिमा सामान्यतः फॉरमॅटपासून वगळल्या जातात. ",
                    "style": {
                        "font_name": "Arial Black",
                        "font_size": null,
                        "font_color": null,
                        "bold": null,
                        "italic": null,
                        "underline": null,
                        "highlight_color": null,
